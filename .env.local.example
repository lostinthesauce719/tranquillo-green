# -----------------------------------------------------------
# Convex
# -----------------------------------------------------------
# Your Convex deployment URL. Found in the Convex dashboard or
# created via `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=https://demo-project.convex.cloud

# -----------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------
# Public publishable key (safe for the browser). Found in the
# Clerk dashboard under API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key (server-only, never expose to the client). Found
# in the Clerk dashboard under API Keys.
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: Override the default Clerk JWT issuer domain.
# Only needed if you use a custom Clerk domain or proxy.
# CLERK_JWT_ISSUER_DOMAIN=https://your-custom-domain.clerk.accounts.dev

# Optional: Name of the Clerk JWT template used for Convex.
# Defaults to "convex" if not set. Create this template in the
# Clerk dashboard under JWT Templates.
# CLERK_CONVEX_JWT_TEMPLATE=convex

# -----------------------------------------------------------
# QuickBooks Online (Intuit)
# -----------------------------------------------------------
# App credentials from https://developer.intuit.com/app/developer/dashboard
# QBO_CLIENT_ID=your_client_id
# QBO_CLIENT_SECRET=your_client_secret
# QBO_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
# QBO_SANDBOX=true

# -----------------------------------------------------------
# OpenAI (if used by the application)
# -----------------------------------------------------------
# OPENAI_API_KEY=***

# -----------------------------------------------------------
# Off-site backup (recommended before real customer data)
# -----------------------------------------------------------
# Shared secret authorizing the backup endpoint. Must ALSO be set as an
# environment variable on the Convex deployment (`npx convex env set`),
# since the export query checks it there too. Backup is disabled when unset.
# BACKUP_SECRET=generate_a_long_random_string

# S3-compatible storage the snapshot is written to. Use an account SEPARATE
# from your Convex account — the point is an independent copy.
# Works with Cloudflare R2, AWS S3, Backblaze B2, or MinIO.
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=tranquillo-green-backups
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=your_access_key
# BACKUP_S3_SECRET_ACCESS_KEY=your_secret_key

# Shared secret for server-to-Convex internal calls (durable rate limiting).
# Must ALSO be set on the Convex deployment. When unset, rate limiting falls
# back to a per-instance in-memory counter.
# INTERNAL_API_SECRET=generate_a_long_random_string

# Comma-separated origins permitted to make cross-origin API requests.
# Unset means same-origin only, which is the right default.
# ALLOWED_ORIGINS=https://app.yourdomain.com

# -----------------------------------------------------------
# Billing provider
# -----------------------------------------------------------
# "invoice" (default) bills by invoice/ACH and depends on no processor.
# "stripe" uses hosted Stripe Checkout — confirm in writing that Stripe will
# underwrite cannabis-adjacent SaaS before routing real revenue through it.
# BILLING_PROVIDER=invoice

# Only needed when BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_QUARTERLY=price_...
# STRIPE_PRICE_ANNUALLY=price_...
